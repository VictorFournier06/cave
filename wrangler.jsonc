{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cave",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-06",

  // Static frontend in ./public; the Worker handles /api/* (asset-first routing).
  "assets": {
    "directory": "./public"
  },

  // Serve on workers.dev; no preview hostnames (they'd bypass Access once it's on).
  "workers_dev": true,
  "preview_urls": false,

  // database_id is a PLACEHOLDER until `wrangler d1 create cave-db`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cave-db",
      "database_id": "c47361ee-5df3-4204-8293-22d496059865"
    }
  ]
}
