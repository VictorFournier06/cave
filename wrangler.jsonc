{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cave",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-06",

  // Static frontend in ./public. run_worker_first routes EVERY request through the
  // Worker first, so the login gate (see src/index.ts) covers the static app shell
  // too — not just /api. The Worker serves the files explicitly via the ASSETS
  // binding once a request is authenticated.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Serve on workers.dev; no preview hostnames (they'd bypass Access once it's on).
  "workers_dev": true,
  "preview_urls": false,

  // database_id is a PLACEHOLDER until `wrangler d1 create cave-db`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cave-db",
      "database_id": "c47361ee-5df3-4204-8293-22d496059865"
    }
  ]
}
